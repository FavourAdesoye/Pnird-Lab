PORT=3000
MONGO_URL=
NODE_ENV=production

# Comma-separated allowlist, e.g. https://app.example.com,https://www.example.com
CORS_ORIGINS=

# Use one of these Firebase options:
# Example: ./pnird-lab-firebase-adminsdk-avod6-7ab2ac3c6f.json
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

OPENAI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_MAINTENANCE_KEY=
# Optional: required in signup body as inviteCode to create staff accounts.
# Set this once on the server (e.g. Render). Staff type it into the app form —
# they do not need codebase or database access.
STAFF_INVITE_CODE=

# Chatbot privacy / retention
# Set to false to answer chats without storing transcripts in MongoDB
CHATBOT_SAVE_CONVERSATIONS=true
# Auto-delete stored conversations older than N days
CHATBOT_RETENTION_DAYS=30
# Max messages kept per conversation (also caps history sent to OpenAI)
CHATBOT_MAX_MESSAGES=40

